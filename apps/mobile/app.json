{
  "expo": {
    "name": "Recalibra",
    "slug": "recalibra",
    "owner": "avalla",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "recalibra",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A19"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.recalibra.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Recalibra needs access to your health data to track HRV and stress levels.",
        "NSHealthUpdateUsageDescription": "Recalibra needs to write session data to Apple Health.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1A19"
      },
      "package": "com.recalibra.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "react-native-health",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "36c38949-bce5-4ae9-ab65-b2798766ae9b"
      }
    }
  }
}
